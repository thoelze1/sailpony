model Note {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  content     String
}

model Sleep {
  id         Int      @id @default(autoincrement())
  bedTime    DateTime
  wakeUpTime DateTime
  createdAt  DateTime @default(now())
}

model Submission {
  id           Int @id @default(autoincrement())
  time         String
  paragraph    String
  number       Int
  date         String
}